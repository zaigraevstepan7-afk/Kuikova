{
  "version": 6,
  "configurePresets": [
    {
      "name": "android",
      "generator": "Ninja",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "D:/sdk/ndk/29.0.13113456/build/cmake/android.toolchain.cmake",
        "ANDROID_NDK": "D:/sdk/ndk/29.0.13113456",
        "ANDROID_PLATFORM": "26",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release-pc",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/release-pc",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-Oz -DNDEBUG -fPIC -flto=thin -fno-rtti -fno-exceptions -fdata-sections -ffunction-sections -fvisibility=hidden -fvisibility-inlines-hidden -fno-unroll-loops -w",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-Wl,--gc-sections -Wl,--strip-all -Wl,--exclude-libs,ALL"
      }
    },
    {
      "name": "release-phone",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/release-phone",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-Oz -DNDEBUG -fPIC -flto -fno-rtti -fno-exceptions -fdata-sections -ffunction-sections -fvisibility=hidden -fvisibility-inlines-hidden -fomit-frame-pointer -fmerge-all-constants -fno-unroll-loops -fno-asynchronous-unwind-tables -fno-stack-protector -falign-functions=1 -falign-jumps=1 -falign-loops=1 -frename-registers -fno-ident -fno-plt -w",
        "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-Wl,--gc-sections -Wl,--strip-all -Wl,--exclude-libs,ALL -Wl,-z,relro,-z,now -Wl,-s"
      }
    },
    {
      "name": "relwithdebinfo-phone",
      "inherits": "android",
      "binaryDir": "${sourceDir}/build/relwithdebinfo-phone",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -fPIC -fno-omit-frame-pointer -fexceptions -frtti -funwind-tables -fstack-protector-strong -w",
        "CMAKE_SHARED_LINKER_FLAGS_RELWITHDEBINFO": "-Wl,--gc-sections -Wl"
      }
    }
  ]
}